<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>BeatMarathon</AssemblyName>
    <RootNamespace>BeatMarathon</RootNamespace>
    <Version>1.0.0</Version>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BeatSaberDir>d:\BSManager\BSInstances\1.40.8</BeatSaberDir>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="BeatMarathon.manifest.json" LogicalName="BeatMarathon.manifest.json" />
    <EmbeddedResource Include="BeatMarathon.UI.Views.SettingsView.bsml" LogicalName="BeatMarathon.UI.Views.SettingsView.bsml" />
  </ItemGroup>

