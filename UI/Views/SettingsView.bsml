<bg xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance'
    xsi:schemaLocation='https://monkeymanboy.github.io/BSML-Docs/ https://raw.githubusercontent.com/monkeymanboy/BSML-Docs/gh-pages/BSMLSchema.xsd'>
  <vertical child-control-height='false' child-expand-height='false'>
    <tab-selector tab-tag='rrm-tab' pad-top='0' />
  </vertical>

  <vertical child-control-height='false' child-expand-height='false' pad-top='8'>
    <tab tags='rrm-tab' tab-name='General'>
      <vertical child-control-height='false' child-expand-height='false' spacing='1'>
        <toggle-setting text='Enable Mod (有効化)' value='enabled' apply-on-change='true' />
        <list-setting text='Data Source (取得元)' value='data-source' choices='data-source-options' apply-on-change='true' />
        <list-setting text='Ranking Scope (絞り込み)' value='ranking-scope' choices='ranking-scope-options' apply-on-change='true' />
        <list-setting text='Display Mode (表示モード)' value='display-mode' choices='display-mode-options' apply-on-change='true' />
        <horizontal child-align='MiddleCenter' pad-top='1'>
          <button text='座標・倍率を初期値に戻す (Reset Defaults)' on-click='reset-defaults' />
        </horizontal>
      </vertical>
    </tab>

    <tab tags='rrm-tab' tab-name='Items'>
      <vertical child-control-height='false' child-expand-height='false' spacing='1'>
        <toggle-setting text='#順位 (Rank)' value='show-rank' apply-on-change='true' />
        <toggle-setting text='アイコン画像 (Avatar)' value='show-avatar' apply-on-change='true' />
        <toggle-setting text='プレイヤー名 (Player Name)' value='show-player-name' apply-on-change='true' />
        <toggle-setting text='精度 (Accuracy %)' value='show-accuracy' apply-on-change='true' />
        <toggle-setting text='自分との精度差 (Delta %)' value='show-delta' apply-on-change='true' />
      </vertical>
    </tab>

    <tab tags='rrm-tab' tab-name='Ground'>
      <vertical child-control-height='false' child-expand-height='false' spacing='1'>
        <increment-setting text='Ground Z-Base (基準奥行き m)' value='ground-z-base' min='0.5' max='8.0' increment='0.1' apply-on-change='true' />
        <increment-setting text='Outer Lane X (外側幅 m)' value='outer-lane-x' min='1.0' max='4.0' increment='0.1' apply-on-change='true' />
        <increment-setting text='Inner Tilt Angle (寝かせ角度)' value='inner-lane-tilt' min='0' max='85' increment='5' apply-on-change='true' />
        <increment-setting text='Distance Scale (地面距離倍率)' value='distance-scale-ground' min='2.0' max='50.0' increment='1.0' apply-on-change='true' />
      </vertical>
    </tab>

    <tab tags='rrm-tab' tab-name='Vertical Pos'>
      <vertical child-control-height='false' child-expand-height='false' spacing='1'>
        <increment-setting text='Distance Scale (縦バー距離倍率)' value='distance-scale-vertical' min='0.2' max='5.0' increment='0.1' apply-on-change='true' />
        <increment-setting text='Vertical Bar Pos X (左右)' value='vbar-pos-x' min='-5.0' max='5.0' increment='0.1' apply-on-change='true' />
        <increment-setting text='Vertical Bar Pos Y (高さ)' value='vbar-pos-y' min='0.0' max='4.0' increment='0.1' apply-on-change='true' />
        <increment-setting text='Vertical Bar Pos Z (奥行き)' value='vbar-pos-z' min='0.5' max='10.0' increment='0.1' apply-on-change='true' />
        <increment-setting text='Vertical Bar Scale (サイズ)' value='vbar-scale' min='0.3' max='3.0' increment='0.05' apply-on-change='true' />
      </vertical>
    </tab>

    <tab tags='rrm-tab' tab-name='Vertical Rot'>
      <vertical child-control-height='false' child-expand-height='false' spacing='1'>
        <increment-setting text='Vertical Bar Rot X (ピッチ)' value='vbar-rot-x' min='-90' max='90' increment='5' apply-on-change='true' />
        <increment-setting text='Vertical Bar Rot Y (ヨー)' value='vbar-rot-y' min='-90' max='90' increment='5' apply-on-change='true' />
        <increment-setting text='Vertical Bar Rot Z (ロール)' value='vbar-rot-z' min='-90' max='90' increment='5' apply-on-change='true' />
        <horizontal child-align='MiddleCenter' pad-top='2'>
          <button text='座標・倍率を初期値に戻す (Reset Defaults)' on-click='reset-defaults' />
        </horizontal>
      </vertical>
    </tab>
  </vertical>
</bg>
